<?xml version="1.0"?>
<!--
  SCENARIO 04: Construction Worker STOP Gesture
  Worker walks into road centre (blocking). mock_perception_publisher injects
  VLM label "STOP" once worker reaches road, simulating arm-raised STOP gesture.

  Usage:
    roslaunch gem_test_scenarios scenario_04_worker_stop_gesture.launch
-->
<launch>
  <arg name="x"   default="0.0"/>
  <arg name="y"   default="0.0"/>
  <arg name="yaw" default="0.0"/>
  <arg name="gui" default="true"/>
  <arg name="vehicle_name" default="e4"/>

  <include file="$(find gem_launch)/launch/gem_init.launch">
    <arg name="world_name"   value="track1.world"/>
    <arg name="custom_scene" value="true"/>
    <arg name="scene_yaml"   value="$(find gem_test_scenarios)/scenes/scenario_04_worker_stop_gesture.yaml"/>
    <arg name="x"            value="$(arg x)"/>
    <arg name="y"            value="$(arg y)"/>
    <arg name="yaw"          value="$(arg yaw)"/>
    <arg name="vehicle_name" value="$(arg vehicle_name)"/>
    <arg name="gui"          value="$(arg gui)"/>
  </include>

  <!-- Mock perception: PROCEED → worker at edge → STOP gesture (8s) → PROCEED -->
  <node pkg="gem_test_scenarios"
        type="mock_perception_publisher.py"
        name="mock_perception"
        output="screen">
    <param name="scenario_type" value="worker_stop"/>
    <param name="trigger_delay" value="3.0"/>
    <param name="loop"          value="true"/>
    <param name="publish_rate"  value="2.0"/>
  </node>
</launch>
