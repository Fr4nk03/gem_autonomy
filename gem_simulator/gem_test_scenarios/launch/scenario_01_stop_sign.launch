<?xml version="1.0"?>
<!--
  SCENARIO 01: Stop Sign in Path
  Launches track1.world with a stop sign 20 m ahead of the vehicle.
  mock_perception_publisher simulates YOLO + VLM detecting the sign after 4 s.

  Usage:
    roslaunch gem_test_scenarios scenario_01_stop_sign.launch
    roslaunch gem_test_scenarios scenario_01_stop_sign.launch x:=0 y:=0 yaw:=0
-->
<launch>
  <arg name="x"   default="0.0"/>
  <arg name="y"   default="0.0"/>
  <arg name="yaw" default="0.0"/>
  <arg name="gui" default="true"/>
  <arg name="vehicle_name" default="e4"/>

  <!-- Launch simulator with scene -->
  <include file="$(find gem_launch)/launch/gem_init.launch">
    <arg name="world_name"   value="track1.world"/>
    <arg name="custom_scene" value="true"/>
    <arg name="scene_yaml"   value="$(find gem_test_scenarios)/scenes/scenario_01_stop_sign.yaml"/>
    <arg name="x"            value="$(arg x)"/>
    <arg name="y"            value="$(arg y)"/>
    <arg name="yaw"          value="$(arg yaw)"/>
    <arg name="vehicle_name" value="$(arg vehicle_name)"/>
    <arg name="gui"          value="$(arg gui)"/>
  </include>

  <!-- Mock perception: injects YOLO stop_sign + VLM STOP after 4 s -->
  <node pkg="gem_test_scenarios"
        type="mock_perception_publisher.py"
        name="mock_perception"
        output="screen">
    <param name="scenario_type" value="stop_sign"/>
    <param name="trigger_delay" value="4.0"/>
    <param name="loop"          value="true"/>
    <param name="publish_rate"  value="2.0"/>
  </node>
</launch>
